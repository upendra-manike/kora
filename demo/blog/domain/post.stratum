module domain Post {
  type Post {
    id: UUID
    title: String
    content: String
    author: Author
    createdAt: Date
    published: Boolean
  }

  type Author {
    id: UUID
    name: String
    email: Email
    bio: String?
  }

  type Comment {
    id: UUID
    postId: UUID
    author: Author
    content: String
    createdAt: Date
  }
}


