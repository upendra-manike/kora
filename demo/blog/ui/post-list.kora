page PostList {
  load() -> Post[]

  view(posts: Post[]) {
    <div className="post-list">
      <h1>Blog Posts</h1>
      <div className="posts">
        {for post in posts {
          <div key={post.id} className="post-card">
            <h2>{post.title}</h2>
            <p className="author">By {post.author.name}</p>
            <p className="date">{post.createdAt}</p>
            <a href={"/posts/" + post.id}>Read more</a>
          </div>
        }}
      </div>
    </div>
  }
}

