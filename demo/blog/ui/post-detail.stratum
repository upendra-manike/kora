page PostDetail {
  load(id: UUID) -> Post

  view(post: Post) {
    <div className="post-detail">
      <article>
        <h1>{post.title}</h1>
        <div className="meta">
          <span className="author">By {post.author.name}</span>
          <span className="date">{post.createdAt}</span>
        </div>
        <div className="content">
          {post.content}
        </div>
      </article>
    </div>
  }
}


