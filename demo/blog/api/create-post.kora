api createPost {
  input {
    title: String
    content: String
    authorId: UUID
  }

  output Post

  handler {
    let post = {
      id: UUID.generate(),
      title: title,
      content: content,
      author: AuthorRepo.find(authorId),
      createdAt: Date.now(),
      published: false
    }
    return PostRepo.save(post)
  }
}

