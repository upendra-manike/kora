api publishPost {
  input {
    id: UUID
  }

  output Post

  handler {
    let post = PostRepo.find(id)
    if (post == null) {
      throw Error("Post not found")
    }
    
    post.published = true
    post.publishedAt = Date.now()
    post.updatedAt = Date.now()
    
    return PostRepo.save(post)
  }
}


