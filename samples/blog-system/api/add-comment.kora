api addComment {
  input {
    postId: UUID
    authorId: UUID
    content: String
    parentId: UUID?
  }

  output Comment

  handler {
    let comment = {
      id: UUID.generate(),
      postId: postId,
      author: UserRepo.find(authorId),
      content: content,
      parentId: parentId,
      likes: 0,
      createdAt: Date.now()
    }
    
    PostRepo.addComment(postId, comment)
    return comment
  }
}

