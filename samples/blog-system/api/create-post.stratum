api createPost {
  input {
    title: String
    content: String
    excerpt: String
    categoryId: UUID
    tagIds: UUID[]
    authorId: UUID
  }

  output Post

  handler {
    let slug = title.toLowerCase().replace(" ", "-")
    let post = {
      id: UUID.generate(),
      title: title,
      slug: slug,
      content: content,
      excerpt: excerpt,
      author: UserRepo.find(authorId),
      category: CategoryRepo.find(categoryId),
      tags: tagIds.map(id => TagRepo.find(id)),
      comments: [],
      published: false,
      publishedAt: null,
      views: 0,
      likes: 0,
      createdAt: Date.now(),
      updatedAt: Date.now()
    }
    return PostRepo.save(post)
  }
}


