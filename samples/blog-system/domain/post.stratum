module domain Post {
  type Post {
    id: UUID
    title: String
    slug: String
    content: String
    excerpt: String
    author: User
    category: Category
    tags: Tag[]
    comments: Comment[]
    published: Boolean
    publishedAt: Date?
    views: Number
    likes: Number
    createdAt: Date
    updatedAt: Date
  }

  type Category {
    id: UUID
    name: String
    slug: String
    description: String?
  }

  type Tag {
    id: UUID
    name: String
    slug: String
  }

  type Comment {
    id: UUID
    postId: UUID
    author: User
    content: String
    parentId: UUID?
    likes: Number
    createdAt: Date
  }
}


