api listUsers {
  input {
    role: UserRole?
    minAge: Number?
    maxAge: Number?
    search: String?
    limit: Number?
    offset: Number?
  }

  output User[]

  handler {
    let query = "SELECT * FROM users WHERE 1=1"
    let params: any[] = []
    let paramIndex = 1

    if (role != null) {
      query += " AND role = $" + paramIndex
      params.push(role)
      paramIndex++
    }

    if (minAge != null) {
      query += " AND age >= $" + paramIndex
      params.push(minAge)
      paramIndex++
    }

    if (maxAge != null) {
      query += " AND age <= $" + paramIndex
      params.push(maxAge)
      paramIndex++
    }

    if (search != null) {
      query += " AND (name ILIKE $" + paramIndex + " OR email ILIKE $" + paramIndex + ")"
      params.push("%" + search + "%")
      paramIndex++
    }

    query += " ORDER BY created_at DESC"
    query += " LIMIT $" + paramIndex
    params.push(limit || 20)
    paramIndex++

    query += " OFFSET $" + paramIndex
    params.push(offset || 0)

    return UserRepo.query(query, params)
  }
}

