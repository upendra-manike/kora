api getUser {
  input {
    id: UUID
  }

  output User

  handler {
    let user = UserRepo.findById(id)
    if (user == null) {
      throw Error("User not found")
    }
    
    // Load profile if exists
    if (user.profile == null) {
      user.profile = UserProfileRepo.findByUserId(id)
    }
    
    return user
  }
}

