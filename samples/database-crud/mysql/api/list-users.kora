api listUsers {
  input {
    role: UserRole?
    minAge: Number?
    maxAge: Number?
    search: String?
    limit: Number?
    offset: Number?
  }

  output User[]

  handler {
    let query = "SELECT * FROM users WHERE 1=1"
    let params: any[] = []

    if (role != null) {
      query += " AND role = ?"
      params.push(role)
    }

    if (minAge != null) {
      query += " AND age >= ?"
      params.push(minAge)
    }

    if (maxAge != null) {
      query += " AND age <= ?"
      params.push(maxAge)
    }

    if (search != null) {
      query += " AND (name LIKE ? OR email LIKE ?)"
      let searchTerm = "%" + search + "%"
      params.push(searchTerm, searchTerm)
    }

    query += " ORDER BY created_at DESC LIMIT ? OFFSET ?"
    params.push(limit || 20, offset || 0)

    return UserRepo.query(query, params)
  }
}

