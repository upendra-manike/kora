module domain User {
  type User {
    id: UUID
    name: String
    email: Email
    age: Number?
    role: UserRole
    profile: UserProfile?
    createdAt: Date
    updatedAt: Date
  }

  type UserProfile {
    bio: String?
    avatar: String?
    location: String?
  }

  type UserRole {
    ADMIN
    USER
    MODERATOR
  }
}


