api listUsers {
  input {
    role: UserRole?
    minAge: Number?
    maxAge: Number?
    search: String?
    limit: Number?
    offset: Number?
  }

  output User[]

  handler {
    let query = {}
    
    if (role != null) {
      query.role = role
    }
    
    if (minAge != null || maxAge != null) {
      query.age = {}
      if (minAge != null) {
        query.age.$gte = minAge
      }
      if (maxAge != null) {
        query.age.$lte = maxAge
      }
    }
    
    if (search != null) {
      query.$or = [
        { name: { $regex: search, $options: "i" } },
        { email: { $regex: search, $options: "i" } }
      ]
    }

    let limit = limit || 20
    let offset = offset || 0

    return UserRepo.find(query, limit, offset)
  }
}


