api createUser {
  input {
    name: String
    email: Email
    age: Number?
    role: UserRole
    profile: UserProfile?
  }

  output User

  handler {
    // Check if user already exists
    let existing = UserRepo.findByEmail(email)
    if (existing != null) {
      throw Error("User with this email already exists")
    }

    // Create new user
    let user = {
      id: UUID.generate(),
      name: name,
      email: email,
      age: age,
      role: role,
      profile: profile,
      createdAt: Date.now(),
      updatedAt: Date.now()
    }

    // Save to MongoDB
    return UserRepo.save(user)
  }
}

