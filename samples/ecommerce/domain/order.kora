module domain Order {
  type Order {
    id: UUID
    userId: UUID
    items: OrderItem[]
    total: Number
    status: OrderStatus
    shippingAddress: Address
    paymentMethod: PaymentMethod
    createdAt: Date
    updatedAt: Date
  }

  type OrderItem {
    productId: UUID
    productName: String
    quantity: Number
    price: Number
  }

  type Address {
    street: String
    city: String
    state: String
    zipCode: String
    country: String
  }

  type OrderStatus {
    PENDING
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
  }

  type PaymentMethod {
    CREDIT_CARD
    DEBIT_CARD
    PAYPAL
    BANK_TRANSFER
  }
}

